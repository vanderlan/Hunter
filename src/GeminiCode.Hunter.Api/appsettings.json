{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "GeminiCode.Hunter.Application.Core.BackgroundServices": "Information"
    }
  },
  "AllowedHosts": "*",

  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 10485760,
      "RequestHeadersTimeout": "00:05:00",
      "KeepAliveTimeout": "00:05:00"
    }
  },

  "ApplicationSettings": {
    "TimeZoneId": "E. South America Standard Time",
    "ConvertTimezoneInResponses": true
  },

  "JobScraper": {
    "CareersUrl": "https://taller.applytojob.com/apply/"
  },

  "LookerStudio": {
    "BatchDataUrl": "",
    "RequestTimeoutSeconds": 30,
    "EncryptionKey": ""
  },

  "FeatureManagement": {
    "AutoCandidateMatching": true
  },

  "Email": {
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpLogin": "",
    "FromEmail": "vanderlan.gs@gmail.com",
    "ToEmails": [
      "vanderlan.gs@gmail.com"
    ],
    "Password": "{password}",
    "EnableSsl": true,
    "ApplicationUrl": "https://hunter.geminicode.com.br"
  },

  "AI": {
    "Provider": "DeepSeek"
  },

  "OpenAI": {
    "ApiKey": ""
    "Model": "gpt-4o"
  },

  "DeepSeek": {
    "ApiKey": "",
    "Model": "deepseek-chat"
  },

  "RateLimiting": {
    "Login": {
      "PermitLimit": 5,
      "WindowInSeconds": 60
    },
    "CvAnalysis": {
      "PermitLimit": 10,
      "WindowInSeconds": 600
    }
  },

  "NewRelic": {
    "AppName": "Hunter",
    "LicenseKey": ""
  }
}
