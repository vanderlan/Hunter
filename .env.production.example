# Hunter Production Environment Variables
# This file should be placed at: ~/projects/hunter/.env on production server
# Make sure to set proper permissions: chmod 600 .env

# ============================================
# DATABASE CONFIGURATION
# ============================================
POSTGRES_DB=HunterProd
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_SECRET_KEY=CHANGE_THIS_TO_256_BIT_BASE64_KEY
JWT_ISSUER=Hunter API
JWT_AUDIENCE=https://hunter.geminicode.com.br
JWT_EXPIRATION_MINUTES=120

# ============================================
# OPENAI CONFIGURATION
# ============================================
OPENAI_API_KEY=CHANGE_THIS_TO_YOUR_OPENAI_KEY

# ============================================
# EMAIL CONFIGURATION
# ============================================
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=vanderlan.gs@gmail.com
EMAIL_TO=vanderlan.gs@gmail.com
EMAIL_PASSWORD=CHANGE_THIS_TO_GMAIL_APP_PASSWORD
EMAIL_ENABLE_SSL=true

# ============================================
# ELASTICSEARCH CONFIGURATION
# ============================================
ELASTICSEARCH_URI=http://elasticsearch:9200

# ============================================
# APPLICATION CONFIGURATION
# ============================================
ASPNETCORE_ENVIRONMENT=Production
ALLOWED_HOSTS=*

# ============================================
# JOB SCRAPER CONFIGURATION
# ============================================
JOB_SCRAPER_URL=https://taller.applytojob.com/apply/

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_AUTO_CANDIDATE_MATCHING=false
